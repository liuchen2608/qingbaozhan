# Copy to .env; never commit real credentials.
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ID=
MODEL_API_KEY=
MODEL_TIMEOUT=90
# Anthropic example: MODEL_PROVIDER=anthropic, MODEL_BASE_URL=https://api.anthropic.com
# HUB_DB=data/hub.sqlite3
# Public HTTPS deployment only (local run does not require login):
# HUB_PUBLIC_MODE=1
# HUB_USERNAME=your-login-name
# HUB_PASSWORD=choose-at-least-16-characters
# HUB_ALLOWED_HOSTS=your-domain.example
